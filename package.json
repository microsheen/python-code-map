{
  "name": "code-map",
  "version": "0.1.0",
  "license": "MIT",
  "author": "microsheen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsheen/python-code-map.git"
  },
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "web": "expo start --web",
    "preweb": "node scripts/copy-wasm.mjs",
    "start": "expo start",
    "export": "expo export --platform web",
    "preexport": "node scripts/copy-wasm.mjs",
    "postexport": "node scripts/inject-html-head.mjs && node scripts/polish-dist.mjs",
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "postinstall": "node scripts/copy-wasm.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "verify": "npm run typecheck && npm run lint && npm test",
    "smoke": "node scripts/browser-verify.mjs",
    "serve:dist": "node scripts/browser-verify.mjs --serve-only",
    "audit:egress": "node scripts/audit-egress.mjs --files=src/feedback/contact.ts,src/components/FeedbackDialog.tsx,src/platform/web/buildStamp.ts,src/platform/web/pullFetch.ts,src/pull/batch.ts,src/pull/errors.ts,src/pull/github.ts,src/pull/githubFetch.ts,src/pull/paths.ts,src/pull/refresh.ts,src/pull/transport.ts,src/pull/urls.ts,src/components/PullEntryDialog.tsx,src/components/PullListingDialog.tsx,src/components/TopBar.tsx --allow-egress=src/platform/web/pullFetch.ts:fetch( --allow-egress=src/components/TopBar.tsx:navigator.clipboard --require-href",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "expo": "~57.0.22",
    "expo-router": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "web-tree-sitter": "0.27.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "jest": "^29.7.0",
    "jest-expo": "57.0.5",
    "prettier": "^3.3.0",
    "typescript": "~5.9.2"
  }
}
